# ============================================
# Hypedrive Frontend - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# .env.local is gitignored and should never be committed

# ============================================
# Application Configuration
# ============================================

# Application URL (used for OAuth callbacks, email links, etc.)
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment (automatically set by Next.js, but can override)
# Options: development | production | test
NODE_ENV="development"

# ============================================
# Encore Backend Configuration
# ============================================

# Encore API URL
# Development: http://localhost:4000 (default Encore local server)
# Production: https://your-encore-app.encr.app
# For custom deployments: https://your-custom-domain.com
ENCORE_API_URL="http://localhost:4000"

# Encore Environment Name (for production deployments)
# Used when NODE_ENV=production to determine which Encore environment to use
# Options: production | staging | preview
ENCORE_ENVIRONMENT="production"

# Client-side Encore URL (for browser/client components)
# Should match ENCORE_API_URL but must be accessible from browser
# Development: http://localhost:4000
# Production: https://your-encore-app.encr.app
NEXT_PUBLIC_ENCORE_URL="http://localhost:4000"

# ============================================
# Better Auth Configuration
# ============================================

# Better Auth Backend URL
# Development: http://localhost:3001 (default Better Auth server)
# Production: https://your-auth-backend.com
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3001"

# Better Auth Secret Key
# Generate with: openssl rand -base64 32
# Must be at least 32 characters
# Used for signing cookies and tokens
BETTER_AUTH_SECRET="your-secret-key-minimum-32-characters-long-change-this-in-production"

# ============================================
# OAuth Providers
# ============================================

# Google OAuth (Optional)
# Get from: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth (Optional)
# Get from: https://github.com/settings/developers
NEXT_PUBLIC_GITHUB_CLIENT_ID=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ============================================
# Novu Notifications (Optional)
# ============================================

# Novu Application ID
# Get from: https://web.novu.co/settings
NEXT_PUBLIC_NOVU_APP_ID=""

# Novu API URL (Optional - defaults to cloud URL)
# Cloud: https://api.novu.co
# Self-hosted: https://your-novu-instance.com
NEXT_PUBLIC_NOVU_API_URL="https://api.novu.co"

# Novu WebSocket URL (Optional - defaults to cloud URL)
# Cloud: wss://ws.novu.co
# Self-hosted: wss://your-novu-instance.com
NEXT_PUBLIC_NOVU_WS_URL="wss://ws.novu.co"

# Novu Secret Key (Server-side only)
# Get from: https://web.novu.co/settings
# Used for server-side notification operations
NOVU_SECRET_KEY=""

# ============================================
# Email Service (Resend) - Optional
# ============================================

# Resend API Key
# Get from: https://resend.com/api-keys
# Used for sending transactional emails
RESEND_API_KEY=""

# ============================================
# Error Tracking (Sentry) - Optional
# ============================================

# Sentry DSN (Client-side)
# Get from: https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN=""

# Sentry DSN (Server-side)
# Get from: https://sentry.io/settings/projects/
SENTRY_DSN=""

# Sentry Auth Token (for releases, source maps)
# Get from: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=""

# ============================================
# Analytics (PostHog) - Optional
# ============================================

# PostHog API Key (Client-side)
# Get from: https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=""

# PostHog Host URL
# Cloud: https://app.posthog.com
# Self-hosted: https://your-posthog-instance.com
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# PostHog API Key (Server-side)
# Get from: https://app.posthog.com/project/settings
POSTHOG_API_KEY=""

# ============================================
# Development & Testing
# ============================================

# Enable API Mocking (MSW)
# Set to "enabled" to use mock API handlers in development
# Only works in development mode
NEXT_PUBLIC_API_MOCKING=""

# Enable Mock Auth (for development/testing)
# Set to "true" to enable mock authentication
# WARNING: Only use in development!
ENABLE_MOCK_AUTH="false"

# Enable Mock Delays (for development/testing)
# Set to "true" to add artificial delays to API calls
# Useful for testing loading states
ENABLE_MOCK_DELAYS="false"

# Skip Environment Variable Validation
# Set to "true" to skip validation (useful for CI/CD)
# WARNING: Not recommended for production
SKIP_ENV_VALIDATION=""

# ============================================
# Database (Future - when adding direct DB access)
# ============================================

# Database Connection URL
# PostgreSQL: postgresql://user:password@localhost:5432/dbname
# MySQL: mysql://user:password@localhost:3306/dbname
# DATABASE_URL=""

# ============================================
# Notes
# ============================================
#
# 1. All variables prefixed with NEXT_PUBLIC_ are exposed to the browser
#    - Never put secrets in NEXT_PUBLIC_ variables
#    - They are bundled into the client-side JavaScript
#
# 2. Server-only variables (without NEXT_PUBLIC_) are secure
#    - Only accessible in Server Components, API Routes, and Server Actions
#    - Never exposed to the browser
#
# 3. Required for basic functionality:
#    - NEXT_PUBLIC_APP_URL
#    - ENCORE_API_URL or NEXT_PUBLIC_ENCORE_URL
#    - BETTER_AUTH_SECRET (if using Better Auth)
#
# 4. Optional but recommended:
#    - Error tracking (Sentry)
#    - Analytics (PostHog)
#    - Notifications (Novu)
#
# 5. Development only:
#    - NEXT_PUBLIC_API_MOCKING
#    - ENABLE_MOCK_AUTH
#    - ENABLE_MOCK_DELAYS
#
# 6. Environment file priority (highest to lowest):
#    - .env.local (gitignored, highest priority)
#    - .env.development / .env.production / .env.test
#    - .env (committed, lowest priority)
#
# 7. Type-safe environment variables:
#    - See lib/env.ts for the schema
#    - All variables are validated at build time
#    - Use `env` from lib/env.ts instead of process.env directly





